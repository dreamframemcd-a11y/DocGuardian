# ---------------------------------------------------------------------------
# DocGuardian — Git 忽略规则
# ---------------------------------------------------------------------------

# Xcode 工程文件（由 XcodeGen 从 project.yml 生成，不需要入库）
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# 编译产物
build/
DerivedData/
out/
*.ipa
*.dSYM
*.app
build.log

# macOS 系统文件
.DS_Store
